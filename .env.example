# Copier vers .env (jamais committer .env)

# Postgres
POSTGRES_USER=applika
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=applika

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_BUCKET=vetbook-media

# API
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
HTTP_PORT=3080

# Web Push (optionnel)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost

# Rappels (optionnel)
# EMAIL_FROM=
