  "tips": [
    {
      "title": "Vérifiez les gencives régulièrement",
      "body": "Des gencives roses et humides sont signe de bonne santé. Des gencives pâles, bleues ou jaunes nécessitent une visite vétérinaire.",
      "category": "sante",
      "author": "App'lika"
    },
    {
      "title": "Rappels de vaccins annuels",
      "body": "N'oubliez pas les rappels annuels (DHPPi, Leptospirose, Rage). Consultez votre vétérinaire pour le protocole adapté.",
      "category": "sante",
      "author": "App'lika"
    },
    {
      "title": "Évitez les aliments toxiques",
      "body": "Chocolat, raisins, oignons, ail, xylitol et noix de macadamia sont toxiques pour les chiens. Gardez-les hors de portée.",
      "category": "alimentation",
      "author": "App'lika"
    },
    {
      "title": "Transition alimentaire progressive",
      "body": "Changez la nourriture sur 7 à 10 jours en mélangeant progressivement l'ancien et le nouveau aliment.",
      "category": "alimentation",
      "author": "App'lika"
    },
    {
      "title": "Eau fraîche toujours disponible",
      "body": "Un chien doit boire environ 50-70 ml d'eau par kg de poids par jour. Renouvelez l'eau régulièrement.",
      "category": "alimentation",
      "author": "App'lika"
    },
    {
      "title": "Socialisation avant 4 mois",
      "body": "La période critique de socialisation est entre 3 et 14 semaines. Exposez votre chiot à différentes personnes, animaux et environnements.",
      "category": "education",
      "author": "App'lika"
    },
    {
      "title": "Renforcement positif",
      "body": "Récompensez les bons comportements plutôt que de punir les mauvais. Friandises, caresses et jeu sont vos meilleurs outils.",
      "category": "education",
      "author": "App'lika"
    },
    {
      "title": "Brossage dentaire 2-3 fois/semaine",
      "body": "Le tartre s'accumule vite. Utilisez un dentifrice spécial chien (jamais de dentifrice humain) et une brosse adaptée.",
      "category": "hygiene",
      "author": "App'lika"
    },
    {
      "title": "Coupe des griffes régulière",
      "body": "Coupez les griffes toutes les 2-4 semaines. Si vous entendez les griffes cliquer sur le sol, elles sont trop longues.",
      "category": "hygiene",
      "author": "App'lika"
    },
    {
      "title": "Nettoyage des oreilles",
      "body": "Nettoyez les oreilles toutes les semaines, surtout pour les races à oreilles tombantes. Utilisez un produit auriculaire vétérinaire.",
      "category": "hygiene",
      "author": "App'lika"
    },
    {
      "title": "Signes de stress à surveiller",
      "body": "Bâillements fréquents, léchage des babines, queue entre les pattes, oreilles plaquées : votre chien peut être stressé.",
      "category": "comportement",
      "author": "App'lika"
    },
    {
      "title": "Exercice quotidien adapté",
      "body": "Un chien adulte a besoin de 30 min à 2h d'exercice par jour selon sa race. Variez les activités : marche, jeu, nage.",
      "category": "comportement",
      "author": "App'lika"
    },
    {
      "title": "Protection anti-parasitaire toute l'année",
      "body": "Les puces et tiques sont actives même en hiver. Maintenez un traitement antiparasitaire régulier toute l'année.",
      "category": "sante",
      "author": "App'lika"
    },
    {
      "title": "Attention au coup de chaleur",
      "body": "Ne laissez jamais un chien dans une voiture fermée. Signes : halètement excessif, bave, titubation. Refroidissez progressivement.",
      "category": "sante",
      "author": "App'lika"
    },
    {
      "title": "Enrichissement mental",
      "body": "Jouets distributeurs, jeux de flair, tricks : un chien mentalement stimulé est un chien équilibré et heureux.",
      "category": "comportement",
      "author": "App'lika"
    }
  ],
