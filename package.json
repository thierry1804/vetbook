{
  "name": "applika",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "start": "npm start --prefix backend",
    "install:all": "npm ci && npm ci --prefix backend && npm ci --prefix frontend && npm ci --prefix admin",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --prefix admin",
    "test:unit": "npm run test:unit --prefix backend",
    "test:fast": "npm run lint && npm run test:unit && npm run typecheck",
    "test:front": "npm run test:browser --prefix frontend",
    "test:integration": "npm run test:integration --prefix backend",
    "test:e2e": "npm run test:e2e --prefix frontend",
    "test": "npm run test:fast && npm run test:front && npm run test:integration",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0"
  }
}
